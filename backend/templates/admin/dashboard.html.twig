{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
<style>
    /* Styles pour la mise en page */
    .flex {
        display: flex;
    }

    .justify-center {
        justify-content: center;
    }

    .text-2xl {
        font-size: 1.5rem;
    }

    .font-bold {
        font-weight: bold;
    }

    .p-4 {
        padding: 1rem;
    }

    .bg-green-500 {
        background-color: #34D399;
    }

    .bg-blue-500 {
        background-color: #3B82F6;
    }

    .bg-yellow-500 {
        background-color: orange;
    }

 

    .text-white {
        color: #FFFFFF;
    }

    .rounded-lg {
        border-radius: 0.5rem;
    }

    .text-lg {
        font-size: 1.125rem;
    }

    .text-3xl {
        font-size: 1.875rem;
    }

   
    .mt-2 {
        margin-top: 0.5rem;
    }

    /* Hover effect */
    .rounded-lg:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

    /* Better list styling */
    ul {
        list-style: none;
        padding: 0;
    }

    li {
        margin-bottom: 1rem;
    }
</style>

<div class="p-4">
    <div class="">
        <h1 class="text-2xl font-bold">Tableau de bord</h1>
    </div>

    <div class="">
        <div class="flex justify-center">
            <div class="w-1/3 p-4">
                <div class="bg-green-500 text-white p-4 rounded-lg">
                    <span class="block text-3xl">{{ userCount }}</span>
                    <span class="text-lg font-bold">Utilisateurs</span>
                </div>
            </div>
            <div class="w-1/3 p-4">
                <div class="bg-blue-500 text-white p-4 rounded-lg">
                    <span class="block text-3xl">{{ livreCount }}</span>
                    <span class="text-lg font-bold">Livres</span>
                </div>
            </div>
            <div class="w-1/3 p-4">
                <div class="bg-yellow-500 text-white p-4 rounded-lg">
                    <span class="block text-3xl">{{ auteurCount }}</span>
                    <span class="text-lg font-bold">Auteurs</span>
                </div>
            </div>
        </div>
    </div>

    <div class="flex justify-center">
        <div class="w-1/2 p-4">
            <div class="bg-grey-500 text-white p-4 rounded-lg">
                <span class="text-lg font-bold">Emprunts en cours</span>
                <ul class="mt-2" id="empruntsEnCours">
                    {% for emprunt in empruntsEnCours %}
                        <li>
                            Livre : {{ emprunt.livre.titre }} <br>
                            Date d'emprunt : {{ emprunt.dateEmprunt|date('d-m-Y') }} <br>
                            Par : {{ emprunt.user.prenom }} {{ emprunt.user.nom }}  <br>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    <div class="container">
    {% if is_granted('ROLE_SUPER_ADMIN') %}
        <div class="w-1/2 p-4">
            <div class="bg-grey-500 text-white p-4 rounded-lg">
                <span class="text-lg font-bold">Emprunts Terminés</span>
                <ul class="mt-2" id="empruntsTermines">
                    {% for emprunt in empruntsTermines %}
                        <li>
                            Livre : {{ emprunt.livre.titre }} <br>
                            Date d'emprunt : {{ emprunt.dateEmprunt|date('d-m-Y') }} <br>
                            Date de retour : {{ emprunt.dateRetour|date('d-m-Y') }} <br>
                            Par : {{ emprunt.user.prenom }} {{ emprunt.user.nom }}  <br>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}
</div>


{% endblock %}
