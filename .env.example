POSTGRES_USER=<POSTGRES_USERNAME>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>

# Use the same values as above or later configure it so that DATABASE URL login with a created user like "backend-service"
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@nyx-db:5432/<POSTGRES_DB>?serverVersion=16

JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PASSPHRASE=<passphrase>